# macOS
.DS_Store
*.swp
*~

# Rork (legacy — no longer building here, kept in case stray files reappear)
.rork/
.env

# Note: Config.swift is intentionally NOT ignored. It holds only non-secret
# app config (backend URL, low-stakes app key) — the real secret
# (ANTHROPIC_API_KEY) lives on the Cloudflare Worker in /backend, never here.
